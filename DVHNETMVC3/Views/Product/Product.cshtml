@model IEnumerable<DVHNETMVC3.Models.Product>
@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var categories = ViewBag.Categories as List<DVHNETMVC3.Models.Category>;
}

<div class="row mt-4">
    <!-- Cột bên trái: Danh mục -->
    <div class="col-md-3">
        <h5 class="text-uppercase fw-bold">DANH MỤC</h5>
        <div class="list-group">
            <a href="/san-pham" class="list-group-item list-group-item-action">Tất cả sản phẩm</a>
            @if (categories != null)
            {
                @foreach (var cat in categories)
                {
                    <a href="/san-pham?categoryId=@cat.Id" class="list-group-item list-group-item-action">
                        @cat.Name
                    </a>
                }
            }
        </div>
    </div>

    <!-- Cột bên phải: Danh sách sản phẩm -->
    <div class="col-md-9">
        <h3>Danh sách sản phẩm</h3>
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <img src="@item.Image " class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title">@item.Name</h6>
                            <p class="card-text text-muted mb-1">
                                <small>Giá: <del>@item.Price</del> Giá: @item.SalePrice</small>
                            </p>
                            <a href="/san-pham/chi-tiet/@item.Id" class="btn btn-success mt-auto">Chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
